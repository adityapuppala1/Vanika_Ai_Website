# Copy to .env for local development (.env is gitignored — never commit it).
# In production set these as Azure App Service application settings, with
# secrets as Key Vault references. See docs/DEPLOYMENT.md.

# ── Web ────────────────────────────────────────────────────────────────
# Comma-separated list of allowed browser origins ("*" allows any)
CORS_ORIGINS=http://localhost:5173,https://vanika.ai,https://www.vanika.ai

# ── Database ───────────────────────────────────────────────────────────
# MongoDB Atlas — required for storing waitlist sign-ups (and InvestorDesk)
# Local: docker compose -f docker-compose.dev.yml up -d  →  mongodb://localhost:27017
MONGODB_URI=
MONGODB_DB_NAME=investor_db

# ── Vanika waitlist ────────────────────────────────────────────────────
# SECRET. Encrypts stored email addresses (AES-256-GCM). Storage is disabled without it.
# Generate once, store in Key Vault, BACK IT UP — losing it makes stored emails unreadable:
#   python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
VANIKA_ENCRYPTION_KEY=
# SECRET. Key for the /admin dashboard:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
VANIKA_ADMIN_KEY=
# Must match VITE_MAIL_ACCESS_KEY in the frontend (public; light spam filter)
VANIKA_ROUTES_KEY=
# standard = work + school + well-known personal providers; work_or_school = no personal providers
VANIKA_EMAIL_POLICY=standard
# Reject domains that cannot receive mail (MX lookup)
VANIKA_EMAIL_DNS_CHECK=true
# Sign-up attempts allowed per IP per minute
VANIKA_SUBSCRIBE_RATE_LIMIT=5
# Optional: separate database / collection for Vanika data
VANIKA_DB_NAME=
VANIKA_WAITLIST_COLLECTION=VanikaWaitlist
# Optional Cloudflare Turnstile bot check (SECRET). Always-pass test secret for local dev:
#   1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=

# ── Vanika mail (Microsoft 365 mailbox info@vanika.ai) ─────────────────
VANIKA_MAIL_FROM=info@vanika.ai
VANIKA_MAIL_FROM_NAME=Vanika.AI
VANIKA_TEAM_INBOX=info@vanika.ai
# auto picks graph if configured, else smtp, else acs
VANIKA_MAIL_TRANSPORT=auto
# Recommended — Microsoft Graph (Entra ID app with Mail.Send application permission)
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
# Bridge — SMTP AUTH with the mailbox password (Microsoft disables this by default end of Dec 2026)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=info@vanika.ai
SMTP_PASSWORD=
# Optional hidden copy of every team notification
EMAIL_BCC_FALLBACK_1=

# ── Other sites on this backend (Anvi, TheBotFactory, InvestorDesk) ────
# Also the legacy Vanika fallback (VANIKA_MAIL_TRANSPORT=auto uses ACS when neither Graph nor SMTP is set)
AZURE_COMMUNICATION_CONNECTION_STRING=
EMAIL_PRIMARY_VANIKA=
EMAIL_PRIMARY_ANVI=
EMAIL_PRIMARY_BOTFACTORY=
EMAIL_FOR_INVESTORDESK=
EMAIL_BCC_FALLBACK_2=
# InvestorDesk — JWT_SECRET is required
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
AZURE_CONNECTION_STRING=
AZURE_CONTAINER_NAME=
STORAGE_PATH_URL=
