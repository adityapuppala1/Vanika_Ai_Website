# Copy to .env (local) and set the same values in the build environment.
# Vite inlines these at build time — never put secrets here.

# Base URL of the FastAPI backend (Backend_Website), without a trailing slash.
# Local dev falls back to http://127.0.0.1:8000 when unset.
VITE_API_BASE_URL=https://<your-backend-host>

# Must match VANIKA_ROUTES_KEY on the backend. Public by design (it ships in
# the JS bundle) — it only filters casual scripted posts.
VITE_MAIL_ACCESS_KEY=
